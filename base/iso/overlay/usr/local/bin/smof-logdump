#!/bin/sh
# smof-logdump: while the live image runs from the Smof boot partition, a copy of the system log is written there every 20 seconds,
# so it can be read from Windows afterwards. Does nothing when the image runs from a normal ISO or USB stick.
DEV=/dev/disk/by-label/SMOF_202611
M=/run/smof-boot
[ -e "$DEV" ] || exit 0
mkdir -p "$M"
mountpoint -q "$M" || mount -o rw,sync "$DEV" "$M" 2>/dev/null || exit 0
mkdir -p "$M/logs"
while :; do
  {
    echo "== time: $(date)"; echo "== failed units"; systemctl --failed --no-pager
    echo "== greetd and session"; journalctl -b --no-pager -u greetd -u seatd 2>/dev/null | tail -80
    echo "== smof tags"; journalctl -b --no-pager -t smof-session -t smof-greeter -t quickshell -t wayfire 2>/dev/null | tail -150
    echo "== kernel graphics, network and firmware"; dmesg 2>/dev/null | grep -i -E "i915|drm|firmware|ath10k|r8169|failed|error" | tail -60
    echo "== devices"; lspci -nnk 2>/dev/null | head -80; ip -br link 2>/dev/null
    echo "== oobe state"; ls -la /var/lib/smof 2>/dev/null; cat /var/lib/smof/oobe-state 2>/dev/null
  } > "$M/logs/boot-latest.txt.tmp" 2>&1
  mv -f "$M/logs/boot-latest.txt.tmp" "$M/logs/boot-latest.txt"
  sync
  sleep 20
done
