#!/usr/bin/python3 -I
# smof-output-init: gives every screen a sensible mode and scale the first time it is seen, on any hardware.
# Runs inside the graphical session. The user's own choice in Settings (an [output:NAME] section in wayfire.ini) is never touched.
import os, sys, json, subprocess

def run(a):
    try: return subprocess.run(a, capture_output=True, text=True, timeout=10).stdout
    except Exception: return ""

def scale_for(w, h, mm_w):
    # about one device pixel per 0.26 mm is a comfortable size at scale 1, going higher as the screen gets denser
    if w >= 3000: return 2.0
    if w >= 2400: return 1.75 if mm_w and w / max(mm_w, 1) > 8 else 1.5
    if w >= 1920: return 1.25 if mm_w and w / max(mm_w, 1) > 6.5 else 1.0
    return 1.0

def main():
    cfg = os.path.expanduser("~/.config/wayfire.ini")
    outs = json.loads(run(["wlr-randr", "--json"]) or "[]")
    text = open(cfg).read() if os.path.exists(cfg) else ""
    for o in outs:
        if not o.get("enabled", True): continue
        name = o["name"]
        if "[output:%s]" % name in text: continue
        modes = o.get("modes", [])
        pref = next((m for m in modes if m.get("preferred")), modes[0] if modes else None)
        if not pref: continue
        mm = (o.get("physical_size") or {}).get("width") or 0
        sc = scale_for(pref["width"], pref["height"], mm)
        mode = "%dx%d@%d" % (pref["width"], pref["height"], round(pref["refresh"]))
        if os.path.exists(cfg):
            text += "\n[output:%s]\nmode = %s\nscale = %s\n" % (name, mode, sc)
            open(cfg, "w").write(text)
        subprocess.run(["wlr-randr", "--output", name, "--mode", "%dx%d" % (pref["width"], pref["height"]), "--scale", str(sc)])
main()
