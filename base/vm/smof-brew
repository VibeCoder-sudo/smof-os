#!/usr/bin/python3 -I
# smof-brew: the helper behind the Homebrew app. Talks to brew and prints JSON.
#   status                 is brew there and can this user use it
#   catalog                every formula that has a bottle for this machine, in a compact form
#   top                    names of the most installed formulae
#   state                  what is installed (on request and with dependencies) and what is outdated
#   refresh                brew update
#   run ACTION [NAME]      install, uninstall or upgrade, prints {"line": ...} while working and {"done": true, "ok": ...} at the end
import sys, os, re, json, time, subprocess, urllib.request

BREW = "/home/linuxbrew/.linuxbrew/bin/brew"
HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".cache/smof-brew")
API = os.path.join(HOME, ".cache/Homebrew/api/internal")
ENV = dict(os.environ, HOMEBREW_NO_ANALYTICS="1", HOMEBREW_NO_AUTO_UPDATE="1", HOMEBREW_NO_ENV_HINTS="1", HOMEBREW_NO_INSTALL_CLEANUP="1", HOMEBREW_COLOR="0", HOMEBREW_NO_EMOJI="1", HOMEBREW_NO_INSTALL_FROM_API="")
os.makedirs(CACHE, exist_ok=True)

def out(o): print(json.dumps(o)); sys.stdout.flush()

def brew(*args, check=False):
    return subprocess.run([BREW, *args], capture_output=True, text=True, env=ENV, cwd=HOME)

def payload_path():
    for f in os.listdir(API) if os.path.isdir(API) else []:
        if f.startswith("packages.") and f.endswith(".jws.json.payload"): return os.path.join(API, f)
    return None

def load_payload():
    p = payload_path()
    if p is None or time.time() - os.path.getmtime(p) > 86400:
        brew("update", "--quiet"); p = payload_path()
    if p is None: return None
    raw = open(p).read()
    return json.loads(raw.split("\n", 1)[1])

def dep_names(lst):
    r = []
    for d in lst or []:
        if isinstance(d, str): r.append(d)
        elif isinstance(d, dict):
            for k, v in d.items():
                if ":build" not in str(v) and ":test" not in str(v): r.append(k)
    return r

def catalog():
    c = os.path.join(CACHE, "catalog.json"); p = payload_path()
    if os.path.exists(c) and p and os.path.getmtime(c) >= os.path.getmtime(p) and time.time() - os.path.getmtime(c) < 86400:
        sys.stdout.write(open(c).read()); return
    d = load_payload()
    if d is None: out([]); return
    res = []
    for name, f in d["formulae"].items():
        if "bottle_checksum" not in f or "disable_args" in f: continue
        res.append({"n": name, "d": f.get("desc") or "", "v": f.get("stable_version") or "", "h": f.get("homepage") or "", "l": f.get("license") if isinstance(f.get("license"), str) else "",
                    "e": (f.get("executables") or [])[:6], "dp": dep_names(f.get("stable_dependencies")), "c": f.get("caveats") or "", "dep": "deprecate_args" in f})
    s = json.dumps(res, separators=(",", ":"))
    open(c, "w").write(s)
    try: sys.stdout.write(s)
    except BrokenPipeError: pass

def top():
    c = os.path.join(CACHE, "top.json")
    if os.path.exists(c) and time.time() - os.path.getmtime(c) < 86400:
        sys.stdout.write(open(c).read()); return
    try:
        data = json.load(urllib.request.urlopen("https://formulae.brew.sh/api/analytics/install-on-request/30d.json", timeout=20))
        names = [i["formula"] for i in data["items"]][:200]
        s = json.dumps(names); open(c, "w").write(s); sys.stdout.write(s)
    except Exception:
        out(json.load(open(c)) if os.path.exists(c) else [])

def state():
    leaves = [l for l in brew("leaves", "--installed-on-request").stdout.split() if l]
    allv = {}
    for line in brew("list", "--formula", "--versions").stdout.splitlines():
        p = line.split()
        if p: allv[p[0]] = p[-1]
    od = {}
    r = brew("outdated", "--formula", "--json=v2")
    try:
        for f in json.loads(r.stdout).get("formulae", []): od[f["name"]] = {"from": (f.get("installed_versions") or [""])[-1], "to": f.get("current_version") or ""}
    except Exception: pass
    out({"leaves": leaves, "all": allv, "outdated": od})

def status():
    ok = os.path.exists(BREW)
    out({"ok": ok, "writable": ok and os.access("/home/linuxbrew/.linuxbrew", os.W_OK), "owner": (lambda s: __import__("pwd").getpwuid(s.st_uid).pw_name)(os.stat("/home/linuxbrew/.linuxbrew")) if ok else ""})

def run(action, name):
    args = {"install": ["install", "--force-bottle"], "uninstall": ["uninstall"], "upgrade": ["upgrade", "--force-bottle"]}.get(action)
    if args is None: out({"done": True, "ok": False, "error": "unknown action"}); return
    if name: args = args + [name]
    p = subprocess.Popen([BREW, *args], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=ENV, cwd=HOME)
    for line in p.stdout:
        line = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", line).replace("\ufe0e", "").replace("\ufe0f", "").strip()
        if line: out({"line": line})
    p.wait()
    out({"done": True, "ok": p.returncode == 0, "name": name or "", "action": action})

def main():
    a = sys.argv[1:]
    if not a: return
    if a[0] == "status": status()
    elif a[0] == "catalog": catalog()
    elif a[0] == "top": top()
    elif a[0] == "state": state()
    elif a[0] == "refresh": brew("update", "--quiet"); out({"ok": True})
    elif a[0] == "run": run(a[1], a[2] if len(a) > 2 else "")
main()
