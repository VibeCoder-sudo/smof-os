#!/bin/sh
# smof-oobe : first run setup as root, called by the lock screen user only while /var/lib/smof/oobe-state exists.
# stdin, five lines: display name, user name, 4 digit PIN, theme (light or dark), keyboard "layouts|variants|switch" (last line may be missing)
S=/var/lib/smof
[ -f "$S/oobe-state" ] || { echo "not allowed" >&2; exit 1; }
read -r NAME; read -r USERN; read -r PIN; read -r THEME; read -r KBD
case "$USERN" in ([a-z]*) ;; (*) echo "bad user" >&2; exit 2;; esac
case "$USERN" in (*[!a-z0-9]*) echo "bad user" >&2; exit 2;; esac
[ "${#USERN}" -le 24 ] || { echo "bad user" >&2; exit 2; }
case "$PIN" in (*[!0-9]*) echo "bad pin" >&2; exit 3;; esac
[ "${#PIN}" -eq 4 ] || { echo "bad pin" >&2; exit 3; }
case "$THEME" in (light|dark) ;; (*) echo "bad theme" >&2; exit 4;; esac
case "$NAME" in (*[\"\\]*) echo "bad name" >&2; exit 5;; esac
[ -n "$NAME" ] && [ "${#NAME}" -le 40 ] || { echo "bad name" >&2; exit 5; }

id "$USERN" >/dev/null 2>&1 || useradd -m -G wheel,video,input,seat,audio,render -s /bin/bash "$USERN" || exit 6
echo "$USERN:$PIN" | chpasswd || exit 7
H=$(getent passwd "$USERN" | cut -d: -f6)
mkdir -p "$H/.config/foot" "$H/.config/fastfetch"
[ -f "$H/.config/wayfire.ini" ] || cp /usr/share/smof/skel/wayfire.ini "$H/.config/wayfire.ini"
[ -f "$H/.config/fastfetch/config.jsonc" ] || cp /usr/share/smof/skel/fastfetch.jsonc "$H/.config/fastfetch/config.jsonc"
[ -f "$H/.config/foot/foot.ini" ] || printf '[main]\nfont=monospace:size=12\n' > "$H/.config/foot/foot.ini"
# keyboard layouts, checked again by smof-input itself
if [ -n "$KBD" ]; then
  KL=${KBD%%|*}; KR=${KBD#*|}; KV=${KR%%|*}; KT=${KR#*|}
  HOME="$H" /usr/local/bin/smof-input layouts set "$KL" "$KV" "$KT" 2>/dev/null || true
fi
chown -R "$USERN:$USERN" "$H/.config"
# the usual folders of a home
for d in Desktop Documents Downloads Music Pictures Videos; do mkdir -p "$H/$d"; chown "$USERN:$USERN" "$H/$d"; done
printf '{"name":"%s","user":"%s","avatar":""}\n' "$NAME" "$USERN" > "$S/user.json"
chmod 644 "$S/user.json"
echo "$THEME" > "$S/theme"; chmod 666 "$S/theme"
rm -f "$S/oobe-state"
sync
exit 0
