#!/usr/bin/env python3
# smof-display: screen resolution, refresh rate and scale. Wayfire applies [output:NAME] from ~/.config/wayfire.ini by itself.
#   list                       JSON: outputs with current mode, scale and the modes the screen offers
#   set NAME WxH@HZ SCALE      writes mode and scale to the config (wayfire applies it within a second)
import sys, os, json, subprocess

def randr():
    try:
        r = subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True, timeout=10)
        return json.loads(r.stdout or "[]")
    except Exception:
        return []

def listing():
    res = []
    for o in randr():
        if not o.get("enabled", True): continue
        by = {}
        cur = None
        for m in o.get("modes", []):
            k = "%dx%d" % (m["width"], m["height"])
            hz = int(round(m["refresh"]))
            by.setdefault(k, set()).add(hz)
            if m.get("current"): cur = {"res": k, "hz": hz}
        modes = [{"res": k, "w": int(k.split("x")[0]), "h": int(k.split("x")[1]), "hz": sorted(v, reverse=True)} for k, v in by.items()]
        modes.sort(key=lambda m: (-m["w"], -m["h"]))
        res.append({"name": o["name"], "model": o.get("model") or o["name"], "current": cur, "scale": o.get("scale", 1.0), "modes": modes})
    return res

a = sys.argv[1:]
if a[:1] == ["list"]:
    print(json.dumps(listing()))
elif len(a) == 4 and a[0] == "set":
    name, mode, scale = a[1], a[2], a[3]
    try: float(scale)
    except ValueError: sys.exit("bad scale")
    if "x" not in mode or "@" not in mode: sys.exit("bad mode")
    inp = os.environ.get("SMOF_INPUT", "/usr/local/bin/smof-input")
    sec = "output:" + name
    subprocess.run([inp, "ini", "set", sec, "mode", mode], check=True)
    subprocess.run([inp, "ini", "set", sec, "scale", scale], check=True)
    try:
        sc = int(round(float(scale) * 100))
        subprocess.run(["/usr/local/bin/smof-activity", "set", "display", "--title", "Display changed", "--sub", "%s, scale %d%%" % (mode.split("@")[0].replace("x", " x "), sc), "--icon", "preferences-desktop-display", "--size", "tiny", "--ttl", "4"], timeout=2, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception: pass
    print("ok")
else:
    sys.exit("usage: smof-display list | set NAME WxH@HZ SCALE")
