#!/usr/bin/python3 -I
# smof-glitch-mem : the real part of the Beta Lab crash test. Runs as root and overwrites bytes in the memory of the user's own running programs,
# a little at first and then more and more, so they start to misbehave and fall over. Only plain working memory of those programs is touched
# (heap, stack, anonymous mappings), never the memory of files, so nothing is written into any file. Kernel memory is not touched.
#   smof-glitch-mem --uid UID --seconds S --pidfile FILE [--exclude PID,PID]      stops when FILE disappears or after S seconds
# Tests: SMOF_GLITCH_PIDS=PID,PID limits the targets to those programs, without it a dry run touches nothing.
import os, sys, time, random, argparse

ap = argparse.ArgumentParser()
ap.add_argument("--uid", type=int, required=True)
ap.add_argument("--seconds", type=float, default=60)
ap.add_argument("--pidfile", required=True)
ap.add_argument("--exclude", default="")
ap.add_argument("--dry", action="store_true")
a = ap.parse_args()
EXC = {int(x) for x in a.exclude.split(",") if x.strip().isdigit()} | {os.getpid()}
FORCED = [int(x) for x in os.environ.get("SMOF_GLITCH_PIDS", "").split(",") if x.strip().isdigit()]
# left alone so the song keeps playing and the test can run its whole minute: the player and what feeds it, the sound server, and the plain system
SKIP = {"smof-glitch", "mpv", "yt-dlp", "node", "python3", "sudo", "systemd", "dbus-daemon", "sshd", "seatd", "login", "greetd",
        "pipewire", "pipewire-pulse", "wireplumber", "pulseaudio"}

def procs():
    if FORCED: return FORCED
    if a.dry: return []
    out = []
    for d in os.listdir("/proc"):
        if not d.isdigit() or int(d) in EXC: continue
        try:
            if os.stat("/proc/" + d).st_uid != a.uid: continue
            comm = open("/proc/%s/comm" % d).read().strip()
        except OSError: continue
        if comm in SKIP: continue
        out.append(int(d))
    return out

def regions(pid):
    r = []
    try:
        for l in open("/proc/%d/maps" % pid):
            p = l.split(None, 5)
            if len(p) < 5 or p[1] != "rw-p": continue
            name = p[5].strip() if len(p) > 5 else ""
            if name and name not in ("[heap]", "[stack]"): continue         # no file memory, no special areas
            lo, hi = (int(x, 16) for x in p[0].split("-"))
            if hi - lo >= 4096: r.append((lo, hi))
    except OSError: pass
    return r

t0 = time.time(); cache = {}; n_total = 0
while time.time() - t0 < a.seconds and os.path.exists(a.pidfile):
    k = (time.time() - t0) / a.seconds
    tick = procs()
    if tick:
        # the pace: about one write per five seconds at the start, around a thousand per second at the end
        n = 0.02 + 120 * k ** 3
        n = int(n) + (1 if random.random() < n - int(n) else 0)
        for _ in range(n):
            pid = random.choice(tick)
            if pid not in cache or random.random() < 0.02: cache[pid] = regions(pid)
            if not cache[pid]: continue
            lo, hi = random.choice(cache[pid])
            addr = random.randrange(lo, hi - 8)
            ln = random.randint(1, 2 + int(600 * k * k))
            try:
                with open("/proc/%d/mem" % pid, "r+b", buffering=0) as m:
                    m.seek(addr); m.write(os.urandom(min(ln, hi - addr))); n_total += 1
            except (OSError, ValueError): cache.pop(pid, None)
    time.sleep(0.1)
print("writes", n_total)
